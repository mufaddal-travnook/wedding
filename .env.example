# Appwrite — guest sign-ins are written here by app/api/guests/route.ts.
# Copy to .env.local for local dev, and add the same vars in the Vercel project settings.
# All of these are server-only (no NEXT_PUBLIC_ prefix) — the API key must never reach the browser.

APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=
APPWRITE_GUESTS_TABLE_ID=guests
